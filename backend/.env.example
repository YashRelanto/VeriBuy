# VeriBuy Backend Environment Variables

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
INTENT_MODEL=qwen3:0.6b
ANALYSIS_MODEL=qwen3:0.6b

# Scraping
SCRAPE_TIMEOUT=10
MAX_SCRAPE_CHARS=5000

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# Reddit API (PRAW)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=VeriBuy:v1.0 (by /u/your_username)

# App
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000
